HOST_UID=1000
HOST_GID=1000

DOCKER_IMAGE_VERSION=1.0.0

DISPLAY=$DISPLAY
WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}
XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/${HOST_UID}}
DOCKER_USER=devuser
DOCKER_HOMEDIR=/home/$DOCKER_USER

COMPOSE_PROJECT_NAME="$USER-musescore"

MUSESCORE_REPO=$DOCKER_HOMEDIR/MuseScore
PULSE_SERVER=unix:/tmp/xdg-runtime/pulse/native