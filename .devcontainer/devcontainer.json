{
    "name": "MuseScore Dev Container",
    "privileged": true,
    // Ensure ~/.Xauthority is a file (not a directory) before Docker mounts it.
    // If it doesn't exist, Docker would create a directory there, breaking X11 auth.
    "initializeCommand": "bash -c 'test -f ~/.Xauthority || (rm -rf ~/.Xauthority && touch ~/.Xauthority)'",
    "dockerComposeFile": [
        "./docker-compose.yml"
        // "./docker-compose.devcontainer.yml"
    ],
    "service": "gui",
    "runServices": ["gui"],  //required, otherwise no services are started
    "workspaceFolder": "/home/devuser/MuseScore",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cmake-tools",  // CMake support: configure, build, debug
                "ms-vscode.cpptools",     // C/C++ IntelliSense, jump to definition, etc.
                "vadimcn.vscode-lldb",    // LLDB debugger support
                "emeraldwalk.RunOnSave",  // Run scripts on file save (run formater uncristify)
                "llvm-vs-code-extensions.vscode-clangd", // Clangd language server for C/C++
                "eamodio.gitlens",
                "mhutchie.git-graph",
                "theqtcompany.qt",
                "tamasfe.even-better-toml",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {

                "cmake.debugConfig": {
                    "name": "CMake Debug",
                    "type": "lldb",
                    "request": "launch",
                    "program": "${command:cmake.launchTargetPath}",
                    "args": [],
                    "cwd": "${workspaceFolder}",
                    "externalConsole": false,
                    "stopAtEntry": false
                },

                "cmake.cmakePath": "/home/devuser/Qt/Tools/CMake/bin/cmake",
                
                "emeraldwalk.runonsave": {
                    "commands": [
                    {
                        "match": "\\.(cpp|c|h|hpp)$",
                        "cmd": "cmake -P ${workspaceFolder}/buildscripts/tools/codestyle/format_file.cmake '${file}'"
                    }
                    ]
                }
            }
        }
    },
}